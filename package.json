{
  "name": "pi-voice-termux",
  "private": true,
  "version": "1.9.0",
  "type": "module",
  "description": "Zero-dependency, local mobile voice and image chat interface for Pi in Termux",
  "repository": { "type": "git", "url": "https://github.com/Endogen/pi-voice.git" },
  "homepage": "https://github.com/Endogen/pi-voice#readme",
  "bugs": "https://github.com/Endogen/pi-voice/issues",
  "scripts": {
    "setup": "node setup.mjs",
    "install:shortcut": "node install-shortcut.mjs",
    "build": "node build.mjs",
    "test": "node build.mjs --check && node --test test/*.test.mjs",
    "test:integration": "node test/integration.mjs",
    "build:native": "node build.mjs && node native/build.mjs",
    "test:native": "node native/integration.mjs",
    "test:native:policy": "node native/test-policy.mjs",
    "test:native:speech": "node native/test-speech.mjs",
    "native:setup": "node native/setup.mjs",
    "native:install": "node native/setup.mjs --install"
  },
  "engines": { "node": ">=22.19" }
}
